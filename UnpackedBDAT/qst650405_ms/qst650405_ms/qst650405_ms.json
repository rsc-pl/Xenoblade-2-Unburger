    {
      "$id": 27,
      "label": "qst650405_0270",
      "style": 82,
      "name": "I ran the numbers, but no.\nThey're too close to the children."
    },
    {
      "$id": 28,
      "label": "qst650405_0280",
      "style": 82,
      "name": "I see..."
    },
    {
      "$id": 29,
      "label": "qst650405_0290",
      "style": 82,
      "name": "No! I'm not letting you eat me!!"
    },
    {
      "$id": 30,
      "label": "qst650405_0300",
      "style": 82,
      "name": "[ML:undisp ]ぐっ！！"
