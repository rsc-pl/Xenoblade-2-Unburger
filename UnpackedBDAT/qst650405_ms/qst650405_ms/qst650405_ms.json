    {
      "$id": 31,
      "label": "qst650405_0310",
      "style": 82,
      "name": "Unforgivable..."
    },
    {
      "$id": 32,
      "label": "qst650405_0320",
      "style": 82,
      "name": "Wait, Hibana?"
    },
    {
      "$id": 33,
      "label": "qst650405_0330",
      "style": 82,
      "name": "I'm going to save them!"
    },
    {
      "$id": 34,
      "label": "qst650405_0340",
      "style": 82,
      "name": "I knew it..."
    },
    {
      "$id": 35,
      "label": "qst650405_0350",
      "style": 82,
      "name": "We have no choice but to go too!"
    },
    {
      "$id": 36,
      "label": "qst650405_0360",
      "style": 82,
      "name": "Why, you!!"
    },
    {
      "$id": 37,
      "label": "qst650405_0370",
      "style": 82,
      "name": "Hibana!"
    },
    {
      "$id": 38,
      "label": "qst650405_0380",
      "style": 82,
      "name": "Sorry. I couldn't hold myself back\nagain..."
    },
    {
      "$id": 39,
      "label": "qst650405_0390",
      "style": 82,
      "name": "No, don't worry. Thanks to you,\nwe have an opening."
    },
    {
      "$id": 40,
      "label": "qst650405_0400",
      "style": 82,
      "name": "Yeah, it was a clever move."
    },
    {
      "$id": 41,
      "label": "qst650405_0410",
      "style": 82,
      "name": "[ML:undisp ]――！"
    },
    {
      "$id": 42,
      "label": "qst650405_0420",
      "style": 82,
      "name": "Besides, I feel the same way as you,\nHibana-chan..."
    },
    {
      "$id": 43,
      "label": "qst650405_0430",
      "style": 82,
      "name": "Homura-senpai..."
    },
    {
      "$id": 44,
      "label": "qst650405_0440",
      "style": 82,
      "name": "Let's get these children home\nas soon as possible."
